####### Compiler, tools and options

CC            = gcc
CXX           = g++
DEFINES       = -DUNICODE -D_UNICODE -DWIN32 -DMINGW_HAS_SECURE_API=1 -DNO_WEBENGINE -DNO_PDFWIDGETS -DNO_WEBSOCKETS -DNO_OPENSSL -DQT_CHARTS_LIB -DQT_OPENGLWIDGETS_LIB -DQT_PRINTSUPPORT_LIB -DQT_WIDGETS_LIB -DQT_OPENGL_LIB -DQT_MULTIMEDIA_LIB -DQT_SVG_LIB -DQT_GUI_LIB -DQT_SQL_LIB -DQT_CONCURRENT_LIB -DQT_QML_LIB -DQT_NETWORK_LIB -DQT_QMLINTEGRATION_LIB -DQT_CORE_LIB
CFLAGS        = -fno-keep-inline-dllexport -g -Wall -Wextra -Wextra $(DEFINES)
CXXFLAGS      = -fno-keep-inline-dllexport -g -std=gnu++1z -Wall -Wextra -Wextra -fexceptions -mthreads $(DEFINES)
INCPATH       = -I. -I. -I../libs/jsonconfig -I../3rdparty/discount -I../../6.10.1/mingw_64/include -I../../6.10.1/mingw_64/include/QtCharts -I../../6.10.1/mingw_64/include/QtOpenGLWidgets -I../../6.10.1/mingw_64/include/QtPrintSupport -I../../6.10.1/mingw_64/include/QtWidgets -I../../6.10.1/mingw_64/include/QtOpenGL -I../../6.10.1/mingw_64/include/QtMultimedia -I../../6.10.1/mingw_64/include/QtSvg -I../../6.10.1/mingw_64/include/QtGui -I../../6.10.1/mingw_64/include/QtSql -I../../6.10.1/mingw_64/include/QtConcurrent -I../../6.10.1/mingw_64/include/QtQml -I../../6.10.1/mingw_64/include/QtNetwork -I../../6.10.1/mingw_64/include/QtQmlIntegration -I../../6.10.1/mingw_64/include/QtCore/6.10.1 -I../../6.10.1/mingw_64/include/QtCore/6.10.1/QtCore -I../../6.10.1/mingw_64/include/QtCore -Idebug -I/include -I../../6.10.1/mingw_64/mkspecs/win32-g++ 
LIB        =        ar -rc
QMAKE         = C:\Qt\6.10.1\mingw_64\bin\qmake.exe
DEL_FILE      = del
CHK_DIR_EXISTS= if not exist
MKDIR         = mkdir
COPY          = copy /y
COPY_FILE     = copy /y
COPY_DIR      = xcopy /s /q /y /i
INSTALL_FILE  = copy /y
INSTALL_PROGRAM = copy /y
INSTALL_DIR   = xcopy /s /q /y /i
QINSTALL      = C:\Qt\6.10.1\mingw_64\bin\qmake.exe -install qinstall
QINSTALL_PROGRAM = C:\Qt\6.10.1\mingw_64\bin\qmake.exe -install qinstall -exe
DEL_FILE      = del
SYMLINK       = $(QMAKE) -install ln -f -s
DEL_DIR       = rmdir
MOVE          = move
IDC           = idc
IDL           = midl
ZIP           = zip -r -9
DEF_FILE      = 
RES_FILE      = 
SED           = $(QMAKE) -install sed
MOVE          = move

