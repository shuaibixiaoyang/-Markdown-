####### Install

install_target: first FORCE
	@if not exist C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.10.1\mingw_64\tests\integration mkdir C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.10.1\mingw_64\tests\integration & if not exist C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.10.1\mingw_64\tests\integration exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.10.1\mingw_64\tests\integration\$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.10.1\mingw_64\tests\integration\$(TARGET)
	-$(DEL_DIR) C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.10.1\mingw_64\tests\integration 


install:  FORCE

uninstall:  FORCE

FORCE:

