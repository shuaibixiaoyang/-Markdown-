####### Install

install_target: first FORCE
	@if not exist C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.10.1\mingw_64\tests\unit mkdir C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.10.1\mingw_64\tests\unit & if not exist C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.10.1\mingw_64\tests\unit exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.10.1\mingw_64\tests\unit\$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.10.1\mingw_64\tests\unit\$(TARGET)
	-$(DEL_DIR) C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.10.1\mingw_64\tests\unit 


install:  FORCE

uninstall:  FORCE

FORCE:

.SUFFIXES:

