		amalloc.h \
		markdown.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o release\xml.o xml.c

release/Csio.o: Csio.c cstring.h \
		amalloc.h \
		config.h \
		markdown.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o release\Csio.o Csio.c

release/xmlpage.o: xmlpage.c config.h \
		cstring.h \
		amalloc.h \
		markdown.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o release\xmlpage.o xmlpage.c

release/basename.o: basename.c config.h \
