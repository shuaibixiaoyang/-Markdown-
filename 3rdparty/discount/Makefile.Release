clean: compiler_clean 
	-$(DEL_FILE) release\mkdio.o release\markdown.o release\dumptree.o release\generate.o release\resource.o release\docheader.o release\version.o release\toc.o release\css.o release\xml.o release\Csio.o release\xmlpage.o release\basename.o release\emmatch.o release\github_flavoured.o release\setup.o release\tags.o release\html5.o release\flags.o

distclean: clean 
	-$(DEL_FILE) release\libdiscount.a
	-$(DEL_FILE) $(DESTDIR_TARGET)
	-$(DEL_FILE) Makefile.Release

check: first

benchmark: first

compiler_no_pch_compiler_make_all:
compiler_no_pch_compiler_clean:
compiler_yacc_decl_make_all:
compiler_yacc_decl_clean:
compiler_yacc_impl_make_all:
compiler_yacc_impl_clean:
compiler_lex_make_all:
compiler_lex_clean:
compiler_clean: 



####### Compile

release/mkdio.o: mkdio.c config.h \
		cstring.h \
		amalloc.h \
		markdown.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o release\mkdio.o mkdio.c

release/markdown.o: markdown.c config.h \
		cstring.h \
		amalloc.h \
		markdown.h \
		tags.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o release\markdown.o markdown.c

release/dumptree.o: dumptree.c markdown.h \
		cstring.h \
		amalloc.h \
		config.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o release\dumptree.o dumptree.c

release/generate.o: generate.c config.h \
		cstring.h \
		amalloc.h \
		markdown.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o release\generate.o generate.c

release/resource.o: resource.c config.h \
		cstring.h \
		amalloc.h \
		markdown.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o release\resource.o resource.c

